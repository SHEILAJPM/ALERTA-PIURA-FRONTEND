# Copiar como .env y completar. Todas son opcionales en desarrollo local.

# Backend (API REST y WebSocket van por el mismo host/puerto).
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000

# Subida de fotos de reportes y reclamos (ver src/utilidades/cloudinary.js).
# Cuenta gratis en cloudinary.com: el cloud name sale del Dashboard; el preset
# se crea en Settings > Upload > Upload presets, en modo "Unsigned". Sin esto,
# el formulario de reportes avisa que la subida de fotos no está configurada.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Mapa base claro/oscuro de CARTO (clave gratis en carto.com/basemaps/apikey).
# Sin ella se usa OpenStreetMap, que funciona igual pero sin variante oscura.
VITE_CARTO_API_KEY=
