# Copiar como .env.android antes de `npm run android:build`.
# La app Android trae la web compilada adentro, así que la URL del backend
# queda fija al compilar el APK.
#
# - Backend en tu PC (misma red WiFi que el celular): la IP de `ipconfig`.
# - Backend en Render: https://<backend>.onrender.com y wss://<backend>.onrender.com
VITE_API_URL=http://192.168.18.248:4000
VITE_WS_URL=ws://192.168.18.248:4000
